#!/usr/bin/env sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
PYTHON_BIN="${RECALL_PYTHON:-python3}"
# SessionEnd has a hard runtime budget.  This command only writes one durable
# metadata record; parsing and sync happen later in `recall jobs drain`.
exec "$PYTHON_BIN" "$ROOT/hooks/scripts/session-end.py" --enqueue "$@"
